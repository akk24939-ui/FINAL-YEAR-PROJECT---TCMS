# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tasmac_user:changeme@localhost:5432/tasmac_db

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret-256-bits
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AES-GCM field encryption (Fernet key, 32-byte URL-safe base64) ──
FIELD_ENCRYPTION_KEY=your-fernet-key-here-generate-with-cryptography

# ── QR HMAC signing ───────────────────────────────────────
QR_HMAC_SECRET=change-me-qr-hmac-secret

# ── App ───────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173
ENVIRONMENT=development
DEBUG=true

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_PURCHASE=30/minute
RATE_LIMIT_EXPORT=1/30seconds
